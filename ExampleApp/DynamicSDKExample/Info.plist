<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is needed to scan WalletConnect QR codes</string>
	<!-- Allow plain http to localhost / *.local for development webViewUrl
	     (e.g. http://localhost:3000). This does NOT disable ATS for other
	     hosts; remote traffic still requires https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
